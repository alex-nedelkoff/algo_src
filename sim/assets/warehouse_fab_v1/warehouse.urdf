      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="warehouse.obj"/></geometry>
    </collision>
    <inertial>
      <mass value="0.0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
</robot>
