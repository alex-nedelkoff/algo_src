# docker-compose.override.yml.example
# ====================================
# Copy this file to docker-compose.override.yml for local development.
# Values here are merged on top of docker-compose.yml automatically.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Credentials (WANDB_API_KEY, R2_*) are loaded from .env via env_file
# in docker-compose.yml — no need to set them here.

services:
  control:
    # Set the experiment to run (required)
    command: ["python", "-m", "training", "+experiment=monorace_baseline"]
    # Optional: mount source for live reloading during development
    # volumes:
    #   - ./control:/app/control
    #   - ./sim:/app/sim
    # Optional: debugpy remote debugger
    # ports:
    #   - "5678:5678"

  perception:
    # command: ["python", "-m", "perception.train"]
    # ports:
    #   - "5679:5678"
